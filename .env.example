# Скопіюйте в .env.local (локально) або впишіть у Vercel → Settings → Environment Variables.

# Адреса сайту (для canonical, Open Graph, sitemap), без слеша в кінці.
NEXT_PUBLIC_SITE_URL=https://kazkarnia.com.ua

# --- Казки від ШІ ---
# 1 — казки пише ШІ, з'являється поле «Про що має бути казка».
NEXT_PUBLIC_AI_ENABLED=1
# Хто пише тексти: gemini або claude (якщо не задано — той, для якого є ключ).
AI_PROVIDER=gemini
# Ключ Gemini: https://aistudio.google.com/apikey (є безкоштовний ліміт).
GEMINI_API_KEY=
# Необов'язково: моделі Gemini.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Ключ Claude: https://console.anthropic.com (платно, без безкоштовного тарифу).
ANTHROPIC_API_KEY=

# --- Ілюстрації від Gemini ---
# 1 — після оплати з'являється кнопка «Намалювати ілюстрації» (потрібен GEMINI_API_KEY).
NEXT_PUBLIC_AI_IMAGES=1

# --- Оплата LiqPay ---
# test — оплата не списується, казка відкривається одразу; live — справжня оплата.
NEXT_PUBLIC_PAYMENT_MODE=test
# Ключі з кабінету LiqPay: Налаштування → API.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# 1 — тестові платежі LiqPay без списання (для перевірки перед запуском).
LIQPAY_SANDBOX=1

# --- Форма «Контакти» ---
# Повідомлення з форми надходять у Telegram. Бота створіть у @BotFather,
# а chat id дізнайтеся, написавши боту й відкривши https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
